{
  "name": "world-atlas",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.{mjs,cjs,js}\" \"tests/**/*.mts\" \"*.mjs\" \"*.ts\" \"docs/**/*.md\" \"README.md\" \".github/**/*.yml\" \"package.json\" \".c8rc.json\" \"electron-builder.yml\"",
    "docs:check": "node scripts/check-project-reference.mjs",
    "lint": "eslint --no-cache --quiet .",
    "lint:map": "eslint --no-cache --quiet src/renderer/src/data/geography/countryHitTesting.ts src/renderer/src/data/geography/opacityMaskLogic.ts src/renderer/src/components/worldMapCountrySelection.ts src/renderer/src/components/worldMapOpacityMasks.ts src/renderer/src/components/worldMapCamera.ts src/renderer/src/components/WorldMapCameraControls.tsx src/renderer/src/components/useWorldMapCountrySelection.ts tests/map-interaction.test.mts tests/map-camera.test.mts",
    "typecheck:tests": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --allowImportingTsExtensions --types node --skipLibCheck --strict tests/*.test.mts",
    "test": "npm run typecheck:tests && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts",
    "coverage": "npm run typecheck:tests && c8 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts",
    "data:flag-metadata": "node scripts/generate-flag-metadata.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "verify": "npm run docs:check && npm run typecheck:node && npm run typecheck:web && npm test && npm run format:check && npm run lint",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "update:capital-data": "node scripts/update-country-capitals.mjs",
    "update:exploration-data": "node scripts/update-country-exploration-data.mjs",
    "update:knowledge-data": "node scripts/generate-country-knowledge-data.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "antimeridian-ts": "^0.1.2",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "polylabel": "^2.1.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "c8": "^12.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg-country-flags": "^1.2.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
